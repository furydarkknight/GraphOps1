# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://graphops:graphops@localhost:5432/graphops?schema=public"
# Separate DB for integration tests (never share with prod/dev):
TEST_DATABASE_URL="postgresql://graphops:graphops@localhost:5432/graphops_test?schema=public"

# ─── Express API ──────────────────────────────────────────────────────────────
PORT=3000
# Must be at least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-32-plus-char-secret-before-deploy"
# HMAC secret for incident passports (different from JWT_SECRET):
PASSPORT_SECRET="change-me-to-a-different-32-plus-char-secret"
NODE_ENV=development

# ─── Analytics service ────────────────────────────────────────────────────────
ANALYTICS_URL="http://localhost:8000"
# Internal shared secret so Express ↔ Analytics calls are authenticated:
ANALYTICS_API_KEY="change-me-analytics-internal-key"

# ─── Gemini (optional) ────────────────────────────────────────────────────────
# Leave unset to run in deterministic-RAG-only mode (clearly labelled in UI).
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Demo mode ────────────────────────────────────────────────────────────────
# Set to "true" to enable /api/auth/register and one-click demo login.
# Never enable in production.
DEMO_MODE=true

# ─── Analytics service (Python side) ─────────────────────────────────────────
ANALYTICS_PORT=8000
ANALYTICS_INTERNAL_KEY="change-me-analytics-internal-key"
# Gemini (passed through; same key as above):
# GEMINI_API_KEY=your-gemini-api-key-here
