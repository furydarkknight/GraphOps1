generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ANALYST
  RESPONDER
  SOC_MANAGER
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContainmentStatus {
  PENDING
  SIMULATED
  APPROVED
  REJECTED
  EXECUTED_SIM
}

enum PassportStatus {
  ISSUED
  REVOKED
}

enum AuditEventKind {
  LOGIN
  HUNT_RUN
  BLAST_CALC
  CONTAINMENT_APPROVE
  PASSPORT_ISSUE
  INGEST
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ANALYST)
  createdAt    DateTime @default(now())

  huntRuns         HuntRun[]
  containmentPlans ContainmentPlan[]
  auditLog         AuditLog[]
  passports        IncidentPassport[]
}

// Immutable audit log — append-only via Prisma (no update/delete exposed in routes)
model AuditLog {
  id        String         @id @default(cuid())
  kind      AuditEventKind
  actorId   String
  actor     User           @relation(fields: [actorId], references: [id])
  targetId  String?
  payload   Json           @db.JsonB
  createdAt DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([kind, createdAt])
}

// ─── Policy & Asset Inventory ─────────────────────────────────────────────────

model DetectionPolicy {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  huntRules   HuntRule[]
  knownGoods  KnownGood[]
  crownJewels AssetNode[] @relation("CrownJewelPolicy")
}

model HuntRule {
  id          String          @id @default(cuid())
  ruleCode    String
  attackId    String?
  tactic      String?
  title       String
  description String          @db.Text
  pattern     Json?
  severity    Severity        @default(MEDIUM)
  isActive    Boolean         @default(true)
  policyId    String
  policy      DetectionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([policyId, ruleCode])
}

model KnownGood {
  id          String          @id @default(cuid())
  code        String
  description String          @db.Text
  sourceLabel String
  sourceUrl   String?
  isActive    Boolean         @default(true)
  policyId    String
  policy      DetectionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([policyId, code])
}

// ─── Graph Snapshots ──────────────────────────────────────────────────────────

model GraphSnapshot {
  id          String    @id @default(cuid())
  label       String
  nodeCount   Int
  edgeCount   Int
  windowStart DateTime?
  windowEnd   DateTime?
  graphJson   Json      @db.JsonB
  inputHash   String
  createdAt   DateTime  @default(now())

  huntRuns  HuntRun[]
  incidents Incident[]

  @@index([createdAt])
}

model AssetNode {
  id               String           @id @default(cuid())
  nodeId           String
  label            String
  nodeType         String
  criticality      Int              @default(5)
  owner            String?
  isCrownJewel     Boolean          @default(false)
  policyId         String?
  crownJewelPolicy DetectionPolicy? @relation("CrownJewelPolicy", fields: [policyId], references: [id])
  createdAt        DateTime         @default(now())
}

// ─── Hunts & Incidents ────────────────────────────────────────────────────────

model HuntRun {
  id                String        @id @default(cuid())
  policyId          String?
  snapshotId        String
  snapshot          GraphSnapshot @relation(fields: [snapshotId], references: [id])
  analystId         String
  analyst           User          @relation(fields: [analystId], references: [id])
  parameters        Json          @db.JsonB
  results           Json?         @db.JsonB
  evidenceReceiptId String?
  createdAt         DateTime      @default(now())

  incidents Incident[]

  @@index([snapshotId, createdAt])
}

model EvidenceReceipt {
  id         String   @id
  huntRunId  String?
  inputHash  String
  configHash String
  resultHash String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Incident {
  id          String        @id @default(cuid())
  title       String
  snapshotId  String
  snapshot    GraphSnapshot @relation(fields: [snapshotId], references: [id])
  huntRunId   String?
  huntRun     HuntRun?      @relation(fields: [huntRunId], references: [id])
  severity    Severity      @default(MEDIUM)
  status      String        @default("OPEN")
  blastRadius Json?         @db.JsonB
  attackPaths Json?         @db.JsonB
  timeline    Json?         @db.JsonB
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  containmentPlans ContainmentPlan[]
  passport         IncidentPassport?
  alerts           Alert[]
}

model Alert {
  id         String    @id @default(cuid())
  raw        Json      @db.JsonB
  source     String
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// ─── Containment ──────────────────────────────────────────────────────────────

model ContainmentPlan {
  id              String            @id @default(cuid())
  incidentId      String
  incident        Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     User              @relation(fields: [requestedById], references: [id])
  actions         Json              @db.JsonB
  simulatedResult Json?             @db.JsonB
  status          ContainmentStatus @default(PENDING)
  exceptionReason String?
  decisionNote    String?           @db.Text
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([incidentId, createdAt])
}

// ─── Passport ─────────────────────────────────────────────────────────────────

model IncidentPassport {
  id           String         @id @default(cuid())
  incidentId   String         @unique
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  issuedById   String
  issuedBy     User           @relation(fields: [issuedById], references: [id])
  passportHash String         @unique
  snapshot     Json           @db.JsonB
  status       PassportStatus @default(ISSUED)
  issuedAt     DateTime       @default(now())

  @@index([issuedAt])
}
